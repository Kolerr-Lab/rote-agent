# Environment variables used by ROTE. Export them in your shell, for example:
#   export OPENAI_API_KEY=...
# The CLI reads process.env only; it does not load a .env file automatically.
# Never commit real keys. Replay and tests need none.

# Required only for `npm run discover -- --provider openai`
OPENAI_API_KEY=

# Optional: model used by the OpenAI discovery provider (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: path to an existing Chromium/Chrome binary, to skip `npx playwright install chromium`
# CUA_CHROMIUM_PATH=/path/to/chrome
